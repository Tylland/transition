<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:api="http://api.trafikinfo.trafikverket.se">
  <xs:annotation>
    <xs:documentation xml:lang="sv">Detta schema är baserat på Produktionsplan v2.1</xs:documentation>
    <xs:documentation xml:lang="en">This schema is based on Produktionsplan v2.1</xs:documentation>
  </xs:annotation>
  <xs:element name="RESPONSE" type="RESPONSE" />
  <xs:complexType name="RESPONSE">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="RESULT" type="RESULT" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RESULT">
    <xs:sequence>
      <xs:element name="DagligFärdplan" type="DagligFärdplanTyp" minOccurs="0" maxOccurs="unbounded" />
      <xs:element minOccurs="0" name="ERROR" type="ERROR" />
      <xs:element minOccurs="0" name="INFO" type="INFO" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="ERROR">
    <xs:sequence>
      <xs:element name="SOURCE" type="xs:string" minOccurs="0" />
      <xs:element name="MESSAGE" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LASTMODIFIED">
    <xs:attribute name="datetime" type="xs:dateTime" use="optional" />
  </xs:complexType>
  <xs:complexType name="EVALRESULT">
    <xs:sequence>
      <xs:any minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="INFO">
    <xs:sequence>
      <xs:element name="LASTMODIFIED" type="LASTMODIFIED" minOccurs="0" />
      <xs:element name="LASTCHANGEID" type="xs:string" minOccurs="0" />
      <xs:element name="EVALRESULT" type="EVALRESULT" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="SSEURL" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DagligFärdplanTyp">
    <xs:complexContent mixed="false">
      <xs:extension base="QueueType">
        <xs:sequence>
          <xs:element api:key="true" minOccurs="1" maxOccurs="1" name="ID" type="DagligFärdplanIDTyp">
            <xs:annotation>
              <xs:documentation xml:lang="sv">100-2016-01-12</xs:documentation>
              <xs:documentation xml:lang="en">100-2016-01-12</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="OperationalTransportIdentifiers" type="CompositIdentifierOperationalType">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Identifierare i TAF/TAP format.</xs:documentation>
              <xs:documentation xml:lang="en">Identifiers in TAF/TAP format.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="1" name="Inställt" type="InställdDagligFärdplanTyp">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Den dagliga färdplanen för denna dag är inställd</xs:documentation>
              <xs:documentation xml:lang="en">The entire daily journey plan for this day is cancelled</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="2" maxOccurs="unbounded" name="Färdplats" type="FärdplatsTyp" />
          <xs:element minOccurs="0" maxOccurs="unbounded" name="InställdaFärder" type="InställdaFärder">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Kollektion av OTN som behövt ställas in helt eller delvis.</xs:documentation>
              <xs:documentation xml:lang="en">Cancelled OTN fully or partially</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="1" name="Tåglägesvariant" type="TåglägesvariantIDTyp">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Tåglägesvarianten som färdplanen realiserar</xs:documentation>
              <xs:documentation xml:lang="en">Parent TrainPathVariant</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="1" name="Tåglägesinnehavare" type="KapacitetsägareTyp">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Den som äger tågläget</xs:documentation>
              <xs:documentation xml:lang="en">Owner of train path</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Operatör" type="OperatörTyp" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Operatör som kör tåget</xs:documentation>
              <xs:documentation xml:lang="sv">Operator running the train</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SenastÄndrad" type="xs:dateTime" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Senaste uppdateringen av kapaciteten</xs:documentation>
              <xs:documentation xml:lang="en">Last update of the capacity</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="Raderad" type="RaderadTyp">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Raderad, objektet borde aldrig ha existerat</xs:documentation>
              <xs:documentation xml:lang="en">Deleted</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="InternationellTrafik" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Tågläget fortsätter i annat land</xs:documentation>
              <xs:documentation xml:lang="en">TrainPath is part of international capacity</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ModifiedTime" type="xs:dateTime">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Tidpunkt då dataposten ändrades i cachen</xs:documentation>
              <xs:documentation xml:lang="en">Time when the data item was changed in the cache</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="Deleted" type="xs:boolean">
            <xs:annotation>
              <xs:documentation xml:lang="sv">Anger att dataposten raderats i cachen</xs:documentation>
              <xs:documentation xml:lang="en">Indicates that the data record has been deleted in the cache</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="QueueType">
    <xs:attribute name="checkoutid" type="xs:string" use="optional" />
    <xs:attribute name="checkouts" type="xs:integer" use="optional" />
    <xs:attribute name="leaseduntil" type="xs:dateTime" use="optional" />
    <xs:attribute name="acknowledged" type="xs:dateTime" use="optional" />
    <xs:attribute name="statuscode" type="xs:unsignedByte" use="optional" />
    <xs:attribute name="itemsacknowledged" type="xs:long" use="optional" />
    <xs:attribute name="itemsleft" type="xs:long" use="optional" />
  </xs:complexType>
  <xs:complexType name="DagligFärdplanIDTyp">
    <xs:sequence>
      <xs:element name="Tågläge" type="TåglägeIDTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Matchar en kalenderdag i tågläget samt den dagliga färdplanen</xs:documentation>
          <xs:documentation xml:lang="en">Matches a calendar day in the train path and the daily journey plan</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Utgångsdag" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Matchar en kalenderdag i tågläget samt den dagliga färdplanen</xs:documentation>
          <xs:documentation xml:lang="en">Matches a calendar day in the train path and the daily journey plan</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CompositIdentifierOperationalType">
    <xs:sequence>
      <xs:element name="ObjectType" type="ObjectType" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ger möjlighet att beskriva olika objekt inför en ansökan, TR = Train, PA = Path, CR = Case Reference, PR = Path Request</xs:documentation>
          <xs:documentation xml:lang="en">Provides a possibility for differentiantion between the objects: Train, Path, Case Reference and Path Request</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Company" type="CompanyCode" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Företagskod UIC för den som utfärdat identiteten</xs:documentation>
          <xs:documentation xml:lang="en">Identifies the RU, IM or other company involved in the Rail Transport Chain</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Core" type="CoreTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Huvuddelen av identifieraren.</xs:documentation>
          <xs:documentation xml:lang="en">It is the main part of identifier and is determent by the company that creates it.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Variant" type="Variant" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Varianten visar relationen mellan två id'n som refererar samma affärsobjekt</xs:documentation>
          <xs:documentation xml:lang="en">The variant shows a relationship between two identifiers referring to the same business case</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TimetableYear" type="TimetableYear" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Refererar till tågplan där behovet ska exekveras</xs:documentation>
          <xs:documentation xml:lang="en">Refers to the timetable period in which the business will be carried out</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="StartDate" type="StartDate" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Starten då behovet exekveras</xs:documentation>
          <xs:documentation xml:lang="en">The start of the date/time in effect</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="InställdDagligFärdplanTyp">
    <xs:sequence>
      <xs:element name="OrsakId" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">ID för orsak (metadata)</xs:documentation>
          <xs:documentation xml:lang="en">Reason Id (metadata)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OrsakBeskrivning" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Orsaksbeskrivning</xs:documentation>
          <xs:documentation xml:lang="en">Reason description</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FärdplatsTyp">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="Avtalsplats" type="FärdAvtalsplatsProdplanTyp" />
      <xs:element minOccurs="0" maxOccurs="1" name="AnkommandeOperativtTåg" type="AnkommandeFärdTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">OTN eller ID för spärrfärd beroende på tågslag</xs:documentation>
          <xs:documentation xml:lang="en">Arrival operational train number or blocked line operation ID (depending on TrainType)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="AvgåendeOperativtTåg" type="AvgåendeFärdTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">OTN eller ID för spärrfärd beroende på tågslag</xs:documentation>
          <xs:documentation xml:lang="en">Arrival operational train number or blocked line operation ID (depending on TrainType)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Inställd" type="InställdFärdPlatsTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Inställed ankomst/avgång för del av sträcka</xs:documentation>
          <xs:documentation xml:lang="en">Cancellation of a part of route</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Ankomst" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ankomsttid</xs:documentation>
          <xs:documentation xml:lang="en">Arrival time</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Avgång" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Avgångstid</xs:documentation>
          <xs:documentation xml:lang="en">Departure time</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Platsspår" type="SpårTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Platsspår, värden enligt metadata</xs:documentation>
          <xs:documentation xml:lang="en">Track to stop at.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="LinjespårAnkomst" type="LinjespårTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">U/N/E där det finns, annars länkId. EJ satt man man inte åker på en linje, t.ex. från DMN till BLG.</xs:documentation>
          <xs:documentation xml:lang="en">Line track in U/N/E format. Only set when actually travelling on a line.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="LinjespårAvgång" type="LinjespårTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">U/N/E där det finns, annars länkId. EJ satt man man inte åker på en linje, t.ex. från DMN till BLG.</xs:documentation>
          <xs:documentation xml:lang="en">Line track in U/N/E format. Only set when actually travelling on a line.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Omledd" type="InställdBasTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Sätts från och med första platsen där omledning börjar till och med sista platsen i omledningen.</xs:documentation>
          <xs:documentation xml:lang="en">Diverting route location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="SpärrfärdssträckansGränspunkter" type="SpärrfärdssträckansGränspunkter">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Sätts endast vid sprärrfärd med gods eller resande. Beskriver spärrfärdssträckans gränspunkter som en kommaseparerad sträng med trafikplatssignaturer.</xs:documentation>
          <xs:documentation xml:lang="en">Provides the textual information about the extend of the blocked line for a blocked line operation starting at this station. It is provided as a comma separated list of the station abbreviation.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Gångtidsberäkning" type="GångtidTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Underlag för gångtidsberäkningen. Används endast för specifika SnapshotObjects</xs:documentation>
          <xs:documentation xml:lang="en">Run time calculation. Only set for specific SnapshotObjects</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Ordningsnummer" type="xs:unsignedInt" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ordningsnummer för platsen</xs:documentation>
          <xs:documentation xml:lang="en">Sequence number for the location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TypAvStopp" type="StoppTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Typ av stopp på plats</xs:documentation>
          <xs:documentation xml:lang="en">Type of Stop on Location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Avstånd" type="xs:unsignedShort" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Avstånd från föregående plats i meter</xs:documentation>
          <xs:documentation xml:lang="en">Distance from previous lcation in meters</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="STH" type="xs:unsignedShort">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Största tillåtna hastighet i km/h</xs:documentation>
          <xs:documentation xml:lang="en">Maximum speed limit in km/h</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="PrimaryLocationCode" type="PrimaryLocationTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Identifierar platsen i TAF/TAP format</xs:documentation>
          <xs:documentation xml:lang="en">Location identification in TAF/TAP format</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Signatur" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Plats med förkortning</xs:documentation>
          <xs:documentation xml:lang="en">Abbrevation of location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="LandsKod" type="LandsKodTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Landskod enligt UIC (Sverige = 74)</xs:documentation>
          <xs:documentation xml:lang="en">Country code according to UIC (Sweden = 74)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Namn" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Namn</xs:documentation>
          <xs:documentation xml:lang="en">Full name</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="InställdaFärder">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="ID" type="FärdIDTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">OTN + utgångsdag</xs:documentation>
          <xs:documentation xml:lang="en">OTN + day of departure</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Från" type="PlatsTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Inställt från denna plats</xs:documentation>
          <xs:documentation xml:lang="en">Cancelled from this location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Till" type="PlatsTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Inställt till denna plats</xs:documentation>
          <xs:documentation xml:lang="en">Cancelled to this location</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="2" maxOccurs="unbounded" name="PlatsLista" type="OrdnadPlatsTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Platslista av samtliga platser som är del av den inställda färden (OTN + Utgångsdag)</xs:documentation>
          <xs:documentation xml:lang="en">List of all locations that is part of the canceled journey (OTN + day of departure)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TåglägesvariantIDTyp">
    <xs:sequence>
      <xs:element name="Tågläge" type="TåglägeIDTyp" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">TåglägeID. Ex. 101, matchar CompositeIdentifierPlannedType.Core i TAF/TAP om Core tillhör tilldelad serie.</xs:documentation>
          <xs:documentation xml:lang="en">Train Path ID. Matches CompositeIdentifierPlannedType.Core in TAF/TAP if Core belongs to assigned number serie.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Variant" type="xs:unsignedShort" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Variant</xs:documentation>
          <xs:documentation xml:lang="en">Variant</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="KapacitetsägareTyp">
    <xs:sequence>
      <xs:element name="OrganisationID" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">ID för organisationen (metadata)</xs:documentation>
          <xs:documentation xml:lang="en">ID for organisation (metadata)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="OperatörTyp">
    <xs:sequence>
      <xs:element name="OperatörID" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">ID för operatören (metadata)</xs:documentation>
          <xs:documentation xml:lang="en">ID for operator (metadata)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="RaderadTyp">
    <xs:annotation>
      <xs:documentation xml:lang="sv">Raderad, indikerar att objektet aldrig var tänkt att existera.</xs:documentation>
      <xs:documentation xml:lang="en">Deleted, this object should never have existed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:boolean" />
  </xs:simpleType>
  <xs:simpleType name="TåglägeIDTyp">
    <xs:annotation>
      <xs:documentation xml:lang="sv">Tåglägesidentifierare</xs:documentation>
      <xs:documentation xml:lang="en">TrainPath identifier</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:totalDigits value="5" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ObjectType">
    <xs:restriction base="xs:string">
      <xs:minLength value="2" />
      <xs:maxLength value="2" />
      <xs:pattern value="[0-9A-Z]{2}" />
      <xs:enumeration value="TR" />
      <xs:enumeration value="PA" />
      <xs:enumeration value="CR" />
      <xs:enumeration value="PR" />
      <xs:enumeration value="TC" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CompanyCode">
    <xs:annotation>
      <xs:documentation xml:lang="sv">Företagskod UIC</xs:documentation>
      <xs:documentation xml:lang="en">Identifies the RU, IM or other company involved in the Rail Transport Chain</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4,4}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CoreTyp">
    <xs:restriction base="xs:string">
      <xs:minLength value="12" />
      <xs:whiteSpace value="replace" />
      <xs:maxLength value="12" />
      <xs:pattern value="[\-\*0-9A-Z]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Variant">
    <xs:restriction base="xs:string">
      <xs:minLength value="2" />
      <xs:maxLength value="2" />
      <xs:pattern value="[0-9A-Z]{2}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TimetableYear">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="2012" />
      <xs:maxInclusive value="2097" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StartDate">
    <xs:restriction base="xs:date">
      <xs:minInclusive value="2012-01-01" />
      <xs:maxInclusive value="2097-12-31" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="FärdAvtalsplatsProdplanTyp">
    <xs:sequence>
      <xs:element minOccurs="0" name="Avtalat" type="AvtalatProdplanTyp">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Information som är en del av avtalet mot kund.</xs:documentation>
          <xs:documentation xml:lang="en">Information that is part of the customer agreement for this location.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AnnonseradAnkomst" type="xs:dateTime">
        <xs:annotation>
