        <xs:annotation>
          <xs:documentation xml:lang="sv">Bromsprov. Används för att manuellt lägga till tillägg på 90s för det retardationsprovet som genomförs under gång strax efter att ett godståg haft uppehåll för av/pålastning samt förarbyte.</xs:documentation>
          <xs:documentation xml:lang="en">Extra time for test of brakes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADJUSTMENT">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Justering</xs:documentation>
          <xs:documentation xml:lang="en">Adjustment</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ENGINEERING">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Banarbetstillägg</xs:documentation>
          <xs:documentation xml:lang="en">Extra time due to track work.</xs:documentation>
