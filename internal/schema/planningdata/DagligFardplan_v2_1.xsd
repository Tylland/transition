      <xs:enumeration value="PATHING">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Infasning</xs:documentation>
          <xs:documentation xml:lang="en">Pathing</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
