        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DISTANCE">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Tågtypstillägg. Tillägg vars storlek beror på vilken tågtyp som framförs (RST, GT*, RST-snabbtåg)</xs:documentation>
          <xs:documentation xml:lang="en">Addition depending on typ eof train (RST, GT*, RST-hight speed train)</xs:documentation>
