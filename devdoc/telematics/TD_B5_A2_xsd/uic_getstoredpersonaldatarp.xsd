<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:element name="GetStoredPersonalDataReply">
		<xs:annotation>
			<xs:documentation>The request can be repeated. The valid feature is the one returned in the last request.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RequestingRailway"/>
				<xs:choice>
					<xs:element name="NegativeReply" type="SimpleNegativeReplyType">
						<xs:annotation>
							<xs:documentation>- Booking not found</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="StoredPersonalData">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="BookingStatus" minOccurs="0">
									<xs:annotation>
										<xs:documentation>open, cancelled, used</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element name="PassengerData" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Passenger" type="PassengerType" maxOccurs="unbounded"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="PersonalDataHistory" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Transaction" type="xs:string">
												<xs:annotation>
													<xs:documentation>provided with booking, changed</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="Time" type="xs:dateTime"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
