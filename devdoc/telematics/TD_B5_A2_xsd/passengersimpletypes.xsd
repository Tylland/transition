			<xs:maxLength value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PriceScopeType">
		<xs:annotation>
			<xs:documentation>scope of a price:  

1 - reservation fee only
2 - price per passenger
3 - price per compartment
4 - price for exact number of requested passengers only (nonlinear dependency between price and number of passengers)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PriceStabilityType">
		<xs:annotation>
			<xs:documentation>stability of a price displayed:

1 - transiient price, price might change immediately
2 - stable for at least one houre on current day in the allocators time zone
3 - stable on the current day in the allocators time zone </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:enumeration value="3"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PriceFlexibilityType">
		<xs:annotation>
			<xs:documentation>classification of a price in:

N - non flexible price   (no exchange or exchange with high fees)
S - semi flexible
F - full flexible (exchangeable)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="N"/>
			<xs:enumeration value="S"/>
			<xs:enumeration value="F"/>
		</xs:restriction>
