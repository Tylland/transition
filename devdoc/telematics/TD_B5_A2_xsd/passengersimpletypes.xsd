	<xs:simpleType name="TrainNumberType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Leaflet 918 element 20 -- the number which the train has at the origin station of the passenger or at the departure station of the car-carrying train.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:maxLength value="5"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TrainServiceIdType">
		<xs:annotation>
			<xs:documentation>Train Id used for customer information. corresponds to TrainServiceNumber for numerical codes, but allows for alphanumerical codes (i.e. used by RZD)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:maxLength value="5"/>
			<xs:whiteSpace value="collapse"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TrainServiceNumberType">
		<xs:annotation>
			<xs:documentation>corresponding to TAP/TSI TrainServiceNumber </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="99999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TravelOfficeOrganizationType">
		<xs:annotation>
			<xs:documentation>Leaflet 918</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="99999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WagonIdentType">
		<xs:annotation>
			<xs:documentation>Identification code of a freight wagon based on the TSI OPE and CEN Recommendations</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="12"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WagonPositionType">
		<xs:annotation>
			<xs:documentation>The number to identify the postion of a wagon within a train</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeightUnitType">
		<xs:restriction base="xs:token">
			<xs:enumeration value="g"/>
			<xs:enumeration value="kg"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TravelersWithCarType">
		<xs:annotation>
			<xs:documentation>Leaflet 918: 77 - Passenger with vehicle</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DocumentTypeType">
		<xs:annotation>
			<xs:documentation>types of legal documents to identify a passenger

1 = passport
2 = id-card
3 = diplomatic passport
4 = refugee travel document</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:int">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
