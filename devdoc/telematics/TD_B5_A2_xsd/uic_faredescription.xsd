<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:element name="FareDescription">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AllocatingRailway" type="xs:string">
					<xs:annotation>
						<xs:documentation>RICS Code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DataVersionId" type="xs:string">
					<xs:annotation>
						<xs:documentation>Unique id for each published data set</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Fare" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>The same fare can be repeated in case there are different rules depending on validity period or service</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Type">
								<xs:annotation>
									<xs:documentation>Code list from 918.8: IRT, RES,..</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Code" type="xs:string">
								<xs:annotation>
									<xs:documentation>code to book the fare (tariff code in case of IRT/RES</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="ValidityPeriod" type="ValidityPeriodType"/>
							<xs:element name="ServiceBrand" type="ServiceBrandInformationType" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Service brand code</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Services" type="xs:string" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>services where the fare is applied (servicelevel code of 918.1)</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="FareDetails">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="PersonalDataUsage" type="PersonalDataUsageType" minOccurs="0" maxOccurs="unbounded"/>
										<xs:element name="SecurityFeatureUsage" type="SecurityFeatureUsageType" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="GenericRules" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Used to include data not depending on fare. i.e. required personal data in case of border crossing</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ValidityPeriod" type="ValidityPeriodType"/>
							<xs:element name="ServiceBrand" type="ServiceBrandInformationType" maxOccurs="unbounded"/>
							<xs:element name="Service" type="xs:string" maxOccurs="unbounded"/>
							<xs:element name="PassengerDataUsage" type="PersonalDataUsageType" maxOccurs="unbounded"/>
							<xs:element name="SecurityFeatureUsage" type="SecurityFeatureUsageType" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
