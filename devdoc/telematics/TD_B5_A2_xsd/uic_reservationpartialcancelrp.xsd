<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="uic_reservationcomplextypes.xsd"/>
	<xs:element name="PartialCancelReply">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Requestor" type="RequestorType"/>
				<xs:element name="Dialogue" type="DialogueType"/>
				<xs:choice>
					<xs:element name="PartialCancelConfirmation" type="PartialCancelBookingConfirmationType"/>
					<xs:element name="NegativeReply" type="NegativeReplyType"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="InformationOnly" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>In case of an informationOnly Reply the reply messages does not provide a new reservation. It does not include a valid reference number. There must not be accountings for these transactions. There must not be correction or synchronization requests made related to these transactions.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
</xs:schema>
