<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:include schemaLocation="uic_reservationcomplextypes.xsd"/>
	<xs:element name="AvailabilityGBReply">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Requestor" type="RequestorType"/>
				<xs:choice>
					<xs:sequence>
						<xs:element name="AvailabilityGB" type="AvailabilityGBType" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:element name="NegativeReply" type="NegativeReplyType">
						<xs:annotation>
							<xs:documentation>- TODO new error code in case no coach is available for graphical reservatiopn</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
