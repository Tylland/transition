<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:element name="GetTicketSecurityRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RequestingRailway" type="xs:string">
					<xs:annotation>
						<xs:documentation>RICS code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="BookingReference">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BookingId" type="xs:string"/>
							<xs:element name="Train" type="xs:string" minOccurs="0"/>
							<xs:element name="DepartureDate" type="xs:date" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="FulfilmentMedium" type="xs:string" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>"phone" security feature for smart phone
"RCCST" security feature for secure paper RCCST
"RCT" security feature for secure paper RCT
"paper" security feature for blank A4 paper
"nomedia" travelling with an Id or Card (SIS Security in System) </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
