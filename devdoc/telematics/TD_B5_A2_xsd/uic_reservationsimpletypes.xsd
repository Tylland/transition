	<xs:simpleType name="TrainHeadType">
		<xs:annotation>
			<xs:documentation>Indicates if a coach is at the head (front or back) of a traind and whether it might be copled with another train part (without dorway to the other train)

0 = no information available
3 = train head (or end)
4 = trainhed (or end) connected to a second train part</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:enumeration value="0"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DirectionOfTravelType">
		<xs:annotation>
			<xs:documentation>Direction of travel
U =unspecified, 
D = in direction 
O = opposite to direction
C = changing
E = starting in direction but changing later
F = starting oposite to direction, but changing later</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="D"/>
			<xs:enumeration value="O"/>
			<xs:enumeration value="C"/>
			<xs:enumeration value="U"/>
			<xs:enumeration value="E"/>
			<xs:enumeration value="F"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LayoutServiceType">
		<xs:annotation>
			<xs:documentation>Leaflet 918 element 15
			Only a subset of codes is used, as most defined codes refere to services not implemented </xs:documentation>
			<xs:documentation>
					01 - Seats in trains
					02 - Couchettes in trains
					03 - Berths in trains
				</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:int">
			<xs:enumeration value="01"/>
			<xs:enumeration value="02"/>
			<xs:enumeration value="03"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LayoutPlaceRemarkType">
		<xs:annotation>
			<xs:documentation>remark on a place:
				value 1: place might have a table
				value 2: table at the place might be missing 				 
				value 3: place might have a different direction
				value 4: place might have a table and a different direction
				value 5: table at the place might be missing and place might have a different direction
				value 6: place might be in compartment

				value 7: 	place might be in open space			  
					</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:int">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6"/>
			<xs:enumeration value="7"/>
		</xs:restriction>
	</xs:simpleType>
