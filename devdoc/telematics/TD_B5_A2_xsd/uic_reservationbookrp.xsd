<xs:schema 
 xmlns:xs="http://www.w3.org/2001/XMLSchema" 
 xmlns="http://www.uic.org/xml/passenger/01" 
 targetNamespace="http://www.uic.org/xml/passenger/01" 
 elementFormDefault="unqualified" 
 attributeFormDefault="unqualified">
	<xs:include schemaLocation="uic_reservationcomplextypes.xsd"/>
	<xs:element name="ReservationReply">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Requestor" type="RequestorType"/>
				<xs:element name="Dialogue" type="DialogueType"/>
				<xs:choice>
					<xs:element name="Allocation" type="AllocationType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>multiple allocations can occur in case of individual ticketing</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NegativeReply">
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="NegativeReplyType"/>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="InformationOnly" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>In case of an informationOnly Reply the reply messages does not provide a reservation. It does not include a valid reference number. There must not be accountings for these transactions. There must not be correction or synchronization requests made related to these transactions.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
</xs:schema>
