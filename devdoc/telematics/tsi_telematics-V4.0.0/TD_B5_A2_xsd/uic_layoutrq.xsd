<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="uic_reservationcomplextypes.xsd"/>
	<xs:element name="LayoutRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RequestingSystem" type="xs:int"/>
				<xs:element name="RequestedLayout">
					<xs:complexType>
						<xs:sequence>
							<xs:annotation>
								<xs:documentation>code of the layout to be loaded or in case of a request for subsequent layouts the last received layout code.</xs:documentation>
							</xs:annotation>
							<xs:element name="LayoutCode" type="xs:token"/>
						</xs:sequence>
						<xs:attribute name="Subsequent" type="xs:boolean" use="optional" default="true">
							<xs:annotation>
								<xs:documentation>true indicates that subsequent layouts should be loaded.</xs:documentation>
							</xs:annotation>
						</xs:attribute>
						<xs:attribute name="LastLoadingId" type="xs:int">
							<xs:annotation>
								<xs:documentation>this is the smalles loadingId af all layouts peviously received. The allocating system will check whether there have been changes since that id was created.</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
