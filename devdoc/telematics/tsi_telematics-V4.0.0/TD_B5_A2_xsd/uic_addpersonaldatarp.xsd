<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.uic.org/xml/passenger/01"
targetNamespace="http://www.uic.org/xml/passenger/01"
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:element name="AddPersonalDataReply">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RequestingRailway"/>
				<xs:choice>
					<xs:element name="Confirmation" type="xs:boolean"/>
					<xs:element name="NegativeReply" type="SimpleNegativeReplyType">
						<xs:annotation>
							<xs:documentation>- Booking not found (..)
- Booking already cancelled (..)
- Booking outdated (departure date is in the past) (..)
- Provided Data is incomplete or outdated (new) 
        (e.g. passport is expired at the travel date)
- Number of passengers provided does not match requirements (new)
- Exchange of passenger(s) not allowed (new)
        (corrections are always allowed) </xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
