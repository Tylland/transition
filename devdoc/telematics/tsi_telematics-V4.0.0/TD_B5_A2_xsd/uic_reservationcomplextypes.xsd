	<xs:complexType name="LayoutPlaceType">
		<xs:attribute name="Type" type="xs:int" use="required">
			<xs:annotation>
				<xs:documentation>type of the place according to the codertabel of graphical item types.
</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="nb" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>place number</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="direction">
			<xs:annotation>
				<xs:documentation>direction of a seat, defined optional as it might be omitted in case of berths in furture. Values R = to right, L = to left, U = up  (from right side of a coach pointing to the middle of the aile), D = down (from right side of the coach pointing to the middle of the aile)</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:length value="1"/>
					<xs:enumeration value="R"/>
					<xs:enumeration value="L"/>
					<xs:enumeration value="U"/>
					<xs:enumeration value="D"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="x" type="GridPositionType" use="required">
			<xs:annotation>
				<xs:documentation>position of the center of this graphical item within the grid</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="y" type="GridPositionType" use="required">
			<xs:annotation>
				<xs:documentation>position of the center of this graphical item within the grid</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="zOrder" type="xs:int">
			<xs:annotation>
				<xs:documentation>graphical layer where this item has to be placed. 

0 = lowest layer usually used for walls 
1 = middle layer usually used by places
2 = top layer usually used by icons</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="remark" type="LayoutPlaceRemarkType">
			<xs:annotation>
				<xs:documentation>remark on a place:
				value 1: place might have a table
				value 2: table at the place might be missing 				 
				value 3: place might have a different direction
			 value 4: place might have a table and a different direction
				value 5: table at the place might be missing and place might have a different direction
			value 6: place might be in compartment

value 7: 	place might be in open space			  
					</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="LayoutInternalType">
		<xs:attribute name="Type" type="xs:int" use="required">
			<xs:annotation>
				<xs:documentation>type of the item according to the codertabel of graphical item types.
</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="x" type="GridPositionType" use="required"/>
		<xs:attribute name="y" type="GridPositionType" use="required"/>
		<xs:attribute name="zOrder" type="xs:int"/>
		<xs:attribute name="mounting" default="F">
			<xs:annotation>
				<xs:documentation>indicates, that the item is located at the upper border (U), the lower border (L), goes from upper to lower border (E) or is placed free (F)</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="U"/>
					<xs:enumeration value="L"/>
					<xs:enumeration value="F"/>
					<xs:enumeration value="E"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="LayoutSignType">
		<xs:attribute name="Type" type="xs:int" use="required">
			<xs:annotation>
				<xs:documentation>type of the icon according to the codertabel of graphical item types.
</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="x" type="GridPositionType" use="required"/>
		<xs:attribute name="y" type="GridPositionType" use="required"/>
		<xs:attribute name="zOrder" type="xs:int"/>
	</xs:complexType>
	<xs:complexType name="CoachLayoutDescriptionType">
		<xs:annotation>
			<xs:documentation>coach layout description to display different coach layouts</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LayoutNT">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="GridSize">
							<xs:annotation>
								<xs:documentation>Total size of the grid that contains all graphical items. All items listed must be within the grid. 

The Corners of the grid are:

  upper left corner:            (0,0)
  upper right corned:         (0,y)
  lower left corner:            (x,0)
  lower right cormner:       (x,y)


Items are places within the grid. 

The granularity of the grid can be finer that the number of places in a row.

A good choice for the vertical grid size would be 25 for coaches up to 4 places in a row and 30 in case of 5 places in a row. The graphical elements for places and icons are approximately of size 5 x 5, so they have a well defined center at (3,3). In any case the size should be even to provide a well defined center.

Graphical items for places and icons should be sized to have an empty frame around them to show underlying compartment walls.
</xs:documentation>
								<xs:documentation>Items are places within the grid. 

The granularity of the grid can be finer that the number of places in a row.

A good choice for the vertical grid size would be 25 for coaches up to 4 places in a row and 30 in case of 5 places in a row. The graphical elements for places and icons are approximately of size 5 x 5, so they have a well defined center at (3,3). In any case the size should be even to provide a well defined center.

Graphical items for places and icons should be sized to have an empty frame around them to show underlying compartment walls.
</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:attribute name="x" type="GridPositionType" use="required"/>
								<xs:attribute name="y" type="GridPositionType" use="required"/>
							</xs:complexType>
						</xs:element>
						<xs:element name="Items">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Place" type="LayoutPlaceType" maxOccurs="200">
										<xs:annotation>
											<xs:documentation>places that can be linked to the availability infoirmation on places. Places have a direction within the grid representing the coach (This is not the direction of travel!).</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Internal" type="LayoutInternalType" minOccurs="0" maxOccurs="100">
										<xs:annotation>
											<xs:documentation>complex graphical objects repüresenting funriture and walls of compartments.

These items can be attached to the upper boundary of the grid or to the lower boundary of the grid.

Usually places and icons are drawn abouve these itemms, so the zOrder should be 0.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Sign" type="LayoutSignType" minOccurs="0" maxOccurs="200">
										<xs:annotation>
											<xs:documentation>simple graphical elements like icons</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="LayoutCode" type="xs:token" use="required">
			<xs:annotation>
				<xs:documentation>unique id of the layout within the scope of the allocating system</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ContainerType" type="xs:int">
			<xs:annotation>
				<xs:documentation>for future use, currently only one container available (rectangle)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AvailabilityGBType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data containing the available services on a train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="AllocatedTrainType"/>
			<xs:element name="avCoach" maxOccurs="25">
				<xs:annotation>
					<xs:documentation>coaches of the train or a part of the coaches of the train, at least one coach.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="avCmp" minOccurs="0" maxOccurs="20">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="avP" minOccurs="0" maxOccurs="10">
										<xs:complexType>
											<xs:attribute name="nb" type="PlaceNumberType" use="required"/>
											<xs:attribute name="sta" type="GbStatusType" use="optional" default="2">
												<xs:annotation>
													<xs:documentation>1 = allocated, 2 = free, 3 = restricted</xs:documentation>
												</xs:annotation>
											</xs:attribute>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="Contingent" type="AllocatedContingentTypeType" use="optional">
									<xs:annotation>
										<xs:documentation>element 51 - Type of compartment  - Position 5 and 6</xs:documentation>
										<xs:documentation/>
										<xs:documentation>element 51 - Type of compartment  - Position 1 and 2 </xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="Type" type="AllocatedCompartmentTypeType" use="optional">
									<xs:annotation>
										<xs:documentation source="Abteilart" xml:lang="de">element 51 - Type of compartment  - Position 1 and 2 </xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="Sex" type="PassengerSexType" use="optional">
									<xs:annotation>
										<xs:documentation source="used with sleeper coaches only" xml:lang="en">mixed or male/femalre compartment for sleepers</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="layout" type="xs:token" use="optional">
						<xs:annotation>
							<xs:documentation>at least one layout must be provided . The description of the layout was retrieved via the layoutRequest. </xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="lowerDeckLayout" type="xs:token" use="optional">
						<xs:annotation>
							<xs:documentation>layout describing the lower deck in case of a double deck coach</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="upperDeckLayout" type="xs:token" use="optional">
						<xs:annotation>
							<xs:documentation>layout describing the upper deck in case of a double deck coach</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="layoutProvider">
						<xs:annotation>
							<xs:documentation>system which provides the layout. Corresponds to allocating system in the layout reply</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="gbStatus" type="GbStatusType" use="required">
						<xs:annotation>
							<xs:documentation>1 = allocated, 2 = free, 3 = restricted</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="number" type="CoachNumberType" use="required"/>
					<xs:attribute name="trainHead" type="TrainHeadType" use="optional">
						<xs:annotation>
							<xs:documentation>0 = no information available
3 = train head (or end)
4 = trainhed (or end) connected to a second train part</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="service" type="LayoutServiceType" use="required"/>
					<xs:attribute name="specialCoach" type="SpecialCoachType" use="optional">
						<xs:annotation>
							<xs:documentation>1 = luggage coach
2 = restaurant coach
5 = bicycle coach</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Direction" type="DirectionOfTravelType" default="U">
						<xs:annotation>
							<xs:documentation>U =unspecified, 
D = in direction 
O = opposite to direction
C = changing
E = starting in direction but changing later</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="coachOwner">
						<xs:annotation>
							<xs:documentation>optional coachOwner. This can be used to indicate the owner at the coach display.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="AllocationOffer" type="AllocationOfferType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allcation offer describes the prefered selectionm the allocating systems recommends for booking. The display for the customer should start with the coach indicated here and it should present the places as a preselection. IN case the issuing system shows only one coach this is the coach to be shown.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocationOfferType">
		<xs:sequence>
			<xs:element name="CoachNb" type="CoachNumberType"/>
			<xs:element name="Place" type="PlaceNumberType" maxOccurs="8"/>
			<xs:element name="IgnoredPreferences" minOccurs="0">
				<xs:complexType>
					<xs:attribute name="PositionOfPlace" type="xs:boolean" default="true"/>
					<xs:attribute name="DirectionOfTravel" type="xs:boolean" default="true"/>
					<xs:attribute name="DirectionOfPlace" type="xs:boolean" default="true"/>
					<xs:attribute name="CompartmentType" type="xs:boolean"/>
					<xs:attribute name="CoachType" type="xs:boolean"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AvailabilityGBTrainRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">All data required to request available places for grafical booking on a train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Service" type="LayoutServiceType" maxOccurs="3"/>
			<xs:element name="Coach" type="CoachNumberType" minOccurs="0"/>
			<xs:element name="Preferences" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The preferences of the customer are required to select the appropriate places for the first display of the coach layout. In case not all coaches are shown these informations are used to select the coiaches to be displayed.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="SeatRequirements" type="SeatRequirementsType" minOccurs="0"/>
						<xs:element name="BerthRequirements" type="BerthRequirementsType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>for future use</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="CouchetteRequirements" type="CouchetteRequirementsType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>for future use</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SeatRequirementsType">
		<xs:sequence>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachType" type="RequestedCoachTypeType" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>not supported by DB</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectionOfTravel" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="DirectionOfTravelType">
							<xs:attribute name="Manadtory" type="xs:boolean" default="false"/>
							<xs:attribute name="Direction" type="DirectionOfTravelType"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CouchetteRequirementsType">
		<xs:sequence>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachType" type="RequestedCoachTypeType" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
			<xs:element name="passengerSex" type="PassengerSexType" minOccurs="0"/>
			<xs:element name="Berths" type="NumberOfBerthsType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BerthRequirementsType">
		<xs:sequence>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="CoachType" type="RequestedCoachTypeType" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>not supported by DB</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectionOfTravel" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="DirectionOfTravelType">
							<xs:attribute name="Manadtory" type="xs:boolean" default="false"/>
							<xs:attribute name="Direction" type="DirectionOfTravelType"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of a vehicle on a car carriage train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="VehicleCategory" type="VehicleCategoryType">
				<xs:annotation>
					<xs:documentation>category of the vehicle - codes of element 29</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleRegistration" type="VehicleRegistrationNumberType">
				<xs:annotation>
					<xs:documentation>plate of the vehicle</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypeOfJourney" type="TypeOfJourneyType">
				<xs:annotation>
					<xs:documentation>element 33 - journey code</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrailerSize" type="TrailerSizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>codes to indicate the size of a trailer - element 45 - trailers </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BoatCategory" type="BoatCategoryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>category of a boat - codes of element 29 when refereing to a boat</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dogs" type="NumberOfPassengerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>number of dogs</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehiclePriceOnlyType" type="xs:boolean" default="true"/>
			<xs:element name="LowerPlattformOnly" type="xs:boolean" default="false" minOccurs="0"/>
			<xs:element name="VehicleHeigth" type="VehicleHeigthType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>vehicle heigth in cm</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
