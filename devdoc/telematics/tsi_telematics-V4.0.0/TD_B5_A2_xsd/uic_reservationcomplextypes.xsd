<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.uic.org/xml/passenger/01" targetNamespace="http://www.uic.org/xml/passenger/01" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="passengersimpletypes.xsd"/>
	<xs:include schemaLocation="passengercomplextypes.xsd"/>
	<xs:include schemaLocation="uic_reservationsimpletypes.xsd"/>
	<xs:complexType name="AllocatedPlacesType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Range or set of allocated places. The allowed number of chiled elements has been choosen to be in line with the definition of the allocated places in leaflet 918.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice maxOccurs="8">
				<xs:element name="Range" type="PlaceRangeType"/>
				<xs:element name="Place" type="PlaceType" maxOccurs="2"/>
			</xs:choice>
			<xs:element name="DistributedAllocation" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>D = place allocation is distributed
S = place allocation is in different compartments mixed with other travellers
</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocatedTrainType">
		<xs:annotation>
			<xs:documentation xml:lang="en">All data describing the allocated train and the allocated relation on that train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DepartureStationName" type="StationNameType">
				<xs:annotation>
					<xs:documentation>station name - element 49</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArrivalStationName" type="StationNameType"/>
			<xs:element name="ServiceBrand" type="ServiceBrandInformationType"/>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDateTime" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation xml:lang="en">In the requests and in the confirmations, this is the date of departure of the train from the passenger’s origin station or the departure date of the car-carrying train. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArrivalDateTime" type="xs:dateTime"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllocationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Allocated Places optionally including the booked offers.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Reference" type="ReferenceNumberType">
				<xs:annotation>
					<xs:documentation>booking reference - element 34</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element name="SeatAllocation" type="SeatAllocationType"/>
				<xs:element name="CouchetteAllocation" type="CouchetteAllocationType"/>
				<xs:element name="BerthAllocation" type="BerthAllocationType"/>
				<xs:element name="VehicleAllocation" type="VehicleAllocationType"/>
				<xs:element name="MealBooking" type="MealBookingType"/>
				<xs:element name="RestaurantSeatAllocation" type="RestaurantSeatAllocationType"/>
			</xs:choice>
			<xs:element name="InfoText" type="InfoTextType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>element 66 - text for special offer</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Carrier" type="CompanyCodeType" minOccurs="0" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>elements 78 / 79 list of carriers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TicketSecurity" type="TicketSecurityType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required"/>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
		<xs:attribute name="TrainChanged" type="xs:boolean" use="optional" default="false">
			<xs:annotation>
				<xs:documentation>true: the train differs from the requested train</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="StationChanged" type="xs:boolean" use="optional" default="false">
			<xs:annotation>
				<xs:documentation>the station differs from the requested station</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="DateChanged" type="xs:boolean" use="optional" default="false">
			<xs:annotation>
				<xs:documentation>the travel date differs from the requested travel date</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AdjacentSeatRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of seats adjacent to a specifies seat.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachNumber" type="CoachNumberType"/>
			<xs:element name="ReferencedPlace" type="PlaceNumberType"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="AdjacentCouchetteRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of chouchettes adjacent to an specified place.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachNumber" type="CoachNumberType"/>
			<xs:element name="ReferencedPlace" type="PlaceNumberType"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="AvailabilityType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data containing the available services on a train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="AllocatedTrainType"/>
			<xs:element name="AvailableService" type="AvailableServiceType" maxOccurs="21"/>
			<xs:element name="CoachType" type="RequestedCoachTypeType" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" minOccurs="0"/>
			<xs:element name="Coach" type="CoachNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>if the request was limited to a single coach ansd the allocating system has retrieved the availability for this coach only the coach number is included here.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required"/>
		<xs:attribute name="RequestedService" type="ServiceType">
			<xs:annotation>
				<xs:documentation>The RequestedService is added to support the translation between binary messges and XML messages in the HitRail translation service . It will not be used after the migration is completed. Systems should therefore not use this element. - element 15</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AvailableOfferType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Available offer</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Tariff" type="TariffCodeUICType"/>
			<xs:element name="Scope" type="PriceScopeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>price scope - element 348</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amount" type="AmountEuroCentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>amount of the tariff not including reservation fees</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Flexibility" type="PriceFlexibilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>price flexibility - element 350</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Stability" type="PriceStabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>price stability - element 347</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" minOccurs="0">
				<xs:annotation>
					<xs:documentation>description text of the tariff</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="0"/>
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:choice maxOccurs="2">
				<xs:element name="Passengers" type="NumberOfPassengerType">
					<xs:annotation>
						<xs:documentation>number of avauilable places if nor separated between smoker and non-smoker</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Smokers" type="NumberOfPassengerType">
					<xs:annotation>
						<xs:documentation>number of available smoker places</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="NonSmokers" type="NumberOfPassengerType">
					<xs:annotation>
						<xs:documentation>number of available non-smoker places</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="Type" type="PriceTypeType" use="required">
			<xs:annotation>
				<xs:documentation>element 67 - type of price</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AvailableServiceType">
		<xs:annotation>
			<xs:documentation xml:lang="en">List of available offers.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Offer" type="AvailableOfferType" maxOccurs="100"/>
		</xs:sequence>
		<xs:attribute name="Service" type="ServiceCodeType" use="required">
			<xs:annotation>
				<xs:documentation>element 308 - service level positions 1 + 2</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AvailabilityRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">All data required to request the available offers on a train.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Service" type="ServiceType">
				<xs:annotation>
					<xs:documentation>element 15</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Coach" type="CoachNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>the request can be limited to  one coach. In this case the reply can be limited to the availability of this coach. The allocating system is allowed to ignore this element, in this case the coach will not be indicated in the reply message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Tariff" type="TariffCodeUICType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>the request can be limited to  the tariffs listed. In this case the reply can be limited to the availability of these tariffs. The allocating system is allowed to ignore this element. - element 352</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required"/>
		<xs:attribute name="WithPrice" type="xs:boolean" default="true">
			<xs:annotation>
				<xs:documentation>The WithPrice flag indicates whether the reply data should include price related data. This element is part of the xml message to suport compatibility with old (classic) 918.1 messages. - element 351</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="AdjacentBerthRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of berths adjacent to a specified place or in a specified coach.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Berths" type="NumberOfBerthsType" minOccurs="0" maxOccurs="2"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachNumber" type="CoachNumberType"/>
			<xs:element name="ReferencedPlace" type="PlaceNumberType"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="BookedOfferType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to describe the offer booked.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Price" type="PriceType" minOccurs="0"/>
			<xs:element name="Supplements" type="SupplementType" minOccurs="0"/>
			<xs:element name="CancelationFees" minOccurs="0">
				<xs:annotation>
					<xs:documentation>information on up to when a cancellation without a fee is allowed by the allocating railway. This information is not given in case of a booking reply.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="CancelationLimit" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Reason" type="ReasonForCancellationType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>element 74 - reason of cancellation</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TimeLimit" type="xs:dateTime">
										<xs:annotation>
											<xs:documentation>time in UTC up to when a free cancellation is possible for that reason without a fee taken by the allocating railway. The time given without a reason applies if the cancellation is made without a reason. </xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BookedMealType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to deascribe a booked meal.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Number" type="NumberOfPassengerType"/>
			<xs:element name="DateTimeOfMeal" type="xs:dateTime" minOccurs="0"/>
			<xs:element name="Price" type="AmountEuroCentType" minOccurs="0"/>
			<xs:element name="Reference" type="ReferenceNumberType" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="Type" type="TypeOfMealType" use="required"/>
	</xs:complexType>
	<xs:complexType name="BerthAllocationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Allocation of berths.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocatedTrain" type="AllocatedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType" minOccurs="0"/>
			<xs:element name="CoachNumber" type="CoachNumberType"/>
			<xs:element name="CoachType" type="AllocatedCoachTypeType" default="0" minOccurs="0"/>
			<xs:element name="CompartmentType" type="AllocatedCompartmentTypeType" default="0" minOccurs="0"/>
			<xs:element name="Contingent" type="AllocatedContingentTypeType" default="0" minOccurs="0"/>
			<xs:element name="PassengerSex" type="PassengerSexType" minOccurs="0"/>
			<xs:element name="ConnectingDoor" type="xs:boolean" default="false" minOccurs="0"/>
			<xs:element name="OverbookedPlaces" type="OverbookedPlacesType" minOccurs="0"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="AllocatedPlaces" type="AllocatedPlacesType"/>
			<xs:element name="BookedOffer" type="BookedOfferType" minOccurs="0"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BerthRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of berths.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Berths" type="NumberOfBerthsType" minOccurs="0" maxOccurs="2"/>
			<xs:element name="Class" type="ClassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Class is usually not applied for berths. In this case the element should be omitted. 

Note on translation to binary messages: A missing class is indicated in the binary messages by a value "0". </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CoachType" type="RequestedCoachTypeType" default="0" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" default="0" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" default="0" minOccurs="0"/>
			<xs:element name="ConnectingDoor" type="xs:boolean" default="false" minOccurs="0"/>
			<xs:element name="PassengerSex" type="PassengerSexType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>element 40 - compartment characteristics (genrer of traveler) </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="CancelBookingConfirmationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data describing the cancelled booking and the refund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Service" type="ServiceType"/>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="Reference" type="ReferenceNumberType"/>
			<xs:element name="DateOfOriginalBooking" type="xs:date"/>
			<xs:element name="OriginalCancellation" minOccurs="0">
				<xs:annotation>
					<xs:documentation>this element has to be sent in case the reservation is already cancelled and the allocator wants to repeat the cancellation confirmation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Date" type="xs:date">
							<xs:annotation>
								<xs:documentation>date and time when the booking was initially cancelled</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Railway" type="ReservationSystemType">
							<xs:annotation>
								<xs:documentation>reservation system code of the railway that made the initial cancellation</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:choice>
				<xs:sequence>
					<xs:element name="CancelledSeats" type="NumberOfPassengerType"/>
					<xs:element name="CancelledMeals" type="RequestedMealType" minOccurs="0" maxOccurs="3"/>
					<xs:element name="Class" type="ClassType"/>
				</xs:sequence>
				<xs:element name="CancelledMeals" type="RequestedMealType" maxOccurs="3"/>
				<xs:element name="CancelledBerths" type="NumberOfBerthsType" maxOccurs="2"/>
				<xs:sequence>
					<xs:element name="CancelledCouchetts" type="NumberOfPassengerType"/>
					<xs:element name="NightStages" type="NumberOfNightStagesType" default="1" minOccurs="0">
						<xs:annotation>
							<xs:documentation>element 60 - number of night sectors</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Class" type="ClassType">
						<xs:annotation>
							<xs:documentation>element 24</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:sequence>
					<xs:element name="VehicleCategory" type="VehicleCategoryType"/>
					<xs:element name="TrailerSize" type="TrailerSizeType" minOccurs="0"/>
					<xs:element name="BoatCategory" type="BoatCategoryType" minOccurs="0"/>
				</xs:sequence>
			</xs:choice>
			<xs:element name="Refund" type="RefundType"/>
			<xs:element name="CancelationFee" type="CancellationFeeType" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required"/>
	</xs:complexType>
	<xs:complexType name="CancellationFeeType">
		<xs:sequence>
			<xs:element name="Amount" type="xs:int">
				<xs:annotation>
					<xs:documentation>Cancellation Fee in Euro Cent</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VAT" type="VatDetailType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>VAT of the cancellation fee</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CancelBookingType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to cancel a booking.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="Reference" type="ReferenceNumberType"/>
			<xs:element name="Service" type="ServiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>element 15 service. This elements is included to support compatibility witrh translation services to old binary messages. In cases where only xml messages are used this element is obsolete.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reason" type="ReasonForCancellationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>reason for cancellation - element 74</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CouchetteRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of chouchettes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="Smoker" type="SmokerType" minOccurs="0"/>
			<xs:element name="CoachType" type="RequestedCoachTypeType" default="0" minOccurs="0"/>
			<xs:element name="CompartmentType" type="RequestedCompartmentTypeType" default="0" minOccurs="0"/>
			<xs:element name="Contingent" type="RequestedContingentTypeType" default="0" minOccurs="0"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="CouchetteAllocationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Allocation of couchettes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocatedTrain" type="AllocatedTrainType"/>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Class" type="ClassType"/>
			<xs:element name="CoachNumber" type="CoachNumberType"/>
			<xs:element name="CoachType" type="AllocatedCoachTypeType" default="0" minOccurs="0"/>
			<xs:element name="CompartmentType" type="AllocatedCompartmentTypeType" default="0" minOccurs="0"/>
			<xs:element name="Contingent" type="AllocatedContingentTypeType" default="0" minOccurs="0"/>
			<xs:element name="NightStages" type="NumberOfNightStagesType" default="1" minOccurs="0"/>
			<xs:element name="OverbookedPlaces" type="OverbookedPlacesType" minOccurs="0"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="AllocatedPlaces" type="AllocatedPlacesType"/>
			<xs:element name="BookedOffer" type="BookedOfferType" minOccurs="0"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DialogueType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to identify a dialogue and to describe the type of the dialogue.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DispositionElement" type="DispositionElementType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">The field contains information about the requesting system which must be quoted back unchanged by the replying system (not with report messages). </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestDate" type="xs:date">
				<xs:annotation>
					<xs:documentation xml:lang="en">Date on which a request is issued. The date is defined in the time zone of the system senmding the request.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ApplicationVersion" type="ApplicationVersionType" use="required">
			<xs:annotation>
				<xs:documentation>element 9 - application version</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="DialogueId" type="DialogueNumberType" use="required">
			<xs:annotation>
				<xs:documentation>element 3 - dialogue number </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Test" type="xs:boolean" use="optional" default="false">
			<xs:annotation>
				<xs:documentation>distinguishes test and production systems:  true = element 11 value 1, false = element 11 value 0</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="MealRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request the booking of a meal.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="TravelersWithCar" type="TravelersWithCarType" minOccurs="0"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
			<xs:element name="Meals" type="RequestedMealType" minOccurs="0" maxOccurs="3"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" use="optional" default="false"/>
	</xs:complexType>
	<xs:complexType name="MealBookingType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request the booking of a meal.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocatedTrain" type="AllocatedTrainType"/>
			<xs:element name="Meals" type="BookedMealType" maxOccurs="3"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NegativeReplyType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to be returned, if a request can not be answered by the desired allocation of train information.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ErrorDescription" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="MissingData" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>tag name of missing or incorrect data element</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Text" minOccurs="0">
							<xs:annotation>
								<xs:documentation>description of the error in English for testing purpose, not designed to be displayed to customers. </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="AlternativeService" type="AlternativeServiceCodeType" minOccurs="0" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>to be used to inform on alternative services avaialable on the requested train. Codes of element 62 - available services</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AlternativeTrain" minOccurs="0">
				<xs:annotation>
					<xs:documentation>to be used to indicate an alternative train and its available services</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Train" type="TrainNumberType"/>
						<xs:element name="Departure" type="xs:dateTime"/>
						<xs:element name="Arrival" type="xs:dateTime"/>
						<xs:element name="ServiceBrand" type="ServiceBrandInformationType"/>
						<xs:element name="AlternativeService" type="AlternativeServiceCodeType" minOccurs="0" maxOccurs="9">
							<xs:annotation>
								<xs:documentation>codes of element 62 </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="AlternativeSystem" minOccurs="0">
				<xs:annotation>
					<xs:documentation>alternative system that hosts the requested train. The train number is given in case the train should be requested with another train number in that system.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="System" type="ReservationSystemType">
							<xs:annotation>
								<xs:documentation>element 1 reservation system code</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Train" type="TrainNumberType" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="optional"/>
		<xs:attribute name="ReplyCode" type="ReplyCodeType" use="optional">
			<xs:annotation>
				<xs:documentation>the reply code might not be included in case of a reply to the indicate an alternative system

element 63</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="NumberOfBerthsType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Number and type of berths. It is possible to request up to two different types in one request. There might be additional restrictions on the possible combinations depending on the reservation systems. Requests containing more than one berth type can n ot contain more than one tariff.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="NumberOfPassengerType">
				<xs:attribute name="Type" type="BerthCodeType" use="required">
					<xs:annotation>
						<xs:documentation>Type of berth: 

    L: Single
    M: Special
    N: Double
    P: T2
    Q: T3
    R: T4
   </xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="PartialCancelBookingType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to cancell some of the places of a booking.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="Reference" type="ReferenceNumberType"/>
			<xs:element name="Service" type="ServiceType"/>
			<xs:element name="Reason" type="ReasonForCancellationType" minOccurs="0"/>
			<xs:element name="PositionOfCompartment" type="PositionOfCompartmentType" minOccurs="0"/>
			<xs:element name="RemainingPlaces" type="NumberOfPassengerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>optional in case of RestaurantSeats</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemainingBerths" type="NumberOfBerthsType" minOccurs="0" maxOccurs="2"/>
			<xs:element name="PositionOfPlaces" type="PositionOfPlaceRequestType" minOccurs="0" maxOccurs="4"/>
			<xs:element name="Tariff" type="TariffRequestType" minOccurs="0" maxOccurs="2"/>
			<xs:element name="PassengerSex" type="PassengerSexType" minOccurs="0"/>
			<xs:element name="RemainingMeals" type="RequestedMealType" minOccurs="0" maxOccurs="3"/>
			<xs:element name="Passenger" type="PassengerType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Travelers remaining in the booking</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FulfilmentMedium" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PartialCancelBookingConfirmationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data confirming a partially cancellation of a booking.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Reference" type="ReferenceNumberType"/>
			<xs:choice>
				<xs:element name="SeatAllocation" type="SeatAllocationType"/>
				<xs:element name="CouchetteAllocation" type="CouchetteAllocationType"/>
				<xs:element name="BerthAllocation" type="BerthAllocationType"/>
				<xs:element name="VehicleAllocation" type="VehicleAllocationType"/>
				<xs:element name="MealBooking" type="MealBookingType"/>
				<xs:element name="RestaurantSeatAllocation" type="RestaurantSeatAllocationType"/>
			</xs:choice>
			<xs:element name="InfoText" type="InfoTextType" minOccurs="0"/>
			<xs:element name="Carrier" type="CompanyCodeType" minOccurs="0" maxOccurs="9"/>
			<xs:element name="CancelledReference" type="ReferenceNumberType"/>
			<xs:element name="OriginalBookingDate" type="xs:date"/>
			<xs:choice>
				<xs:element name="CancelledPassengers" type="NumberOfPassengerType"/>
				<xs:element name="CancelledBerths" type="NumberOfBerthsType" maxOccurs="2"/>
				<xs:element name="CancelledMeals" type="RequestedMealType" maxOccurs="3"/>
				<xs:element name="CancelledTrailerSize" type="TrailerSizeType" minOccurs="0"/>
			</xs:choice>
			<xs:element name="Refund" type="RefundType"/>
			<xs:element name="Fee" type="CancellationFeeType" minOccurs="0"/>
			<xs:element name="OriginalCancellation" minOccurs="0">
				<xs:annotation>
					<xs:documentation>this element has to be sent in case the reservation is already cancelled and the allocator wants to repeat the partial cancellation confirmation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Date" type="xs:date">
							<xs:annotation>
								<xs:documentation>date and time when the booking was initially partially cancelled</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Railway" type="ReservationSystemType">
							<xs:annotation>
								<xs:documentation>reservation system code of the railway that made the initial partial cancellation</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="TicketSecurity" type="TicketSecurityType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required"/>
	</xs:complexType>
	<xs:complexType name="PartialPriceType">
		<xs:annotation>
			<xs:documentation xml:lang="en">As a reservation might contain more than one tariff, the partial price can be used to define the price per tariff code. This partial price is needed to calculate the totalm price in different currencies, as the currency conversion has to be aplied on the price per tariff and passenger to avoid rounding errors.
</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Tariff" type="TariffCodeUICType"/>
			<xs:element name="Label" type="TariffCodeDescrType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>printable label of the tariff</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Passengers" type="NumberOfPassengerType"/>
			<xs:element name="Amount" type="AmountEuroCentType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlaceRangeType">
		<xs:annotation>
			<xs:documentation xml:lang="en">A Range of places. The Range is defined by the first and last place number. The range does not indicate, that all place numbers between these two numbers are allocated, as the coach section might not contain all place numbers. All places taht are contained in the coach between and including the first and the last place number are allocated.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Code" type="PlaceCodeType">
			<xs:annotation>
				<xs:documentation>place code - codes as defined in element 50 except for code 0.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="FromPlace" type="PlaceNumberType"/>
		<xs:attribute name="ToPlace" type="PlaceNumberType"/>
	</xs:complexType>
	<xs:complexType name="PlaceType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Number and type of a place.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Place" type="PlaceNumberType"/>
		<xs:attribute name="Code" type="PlaceCodeType">
			<xs:annotation>
				<xs:documentation>place codes according to element 50 except for code 0.

code "/"   is replaced by "m"
code "=" is replaced by "n"</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="PositionOfPlaceRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Customer request for a specific location of a place.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="NumberOfPositionsType">
				<xs:attribute name="Mandatory" type="xs:boolean" default="false">
					<xs:annotation>
						<xs:documentation>true = the request of the place position is mandatory. In case that the plce position can not be allocated the requrest must fail.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Position" type="PositionOfPlaceType">
					<xs:annotation>
						<xs:documentation>code of the position of the places: 
   W = window
   A  = aile / gangway
   M  = middle / middle level
   I  =  isolated window
   U =  upper level (berth, couchette)
   L =  lower level (berth, couchette)
</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="PriceType">
		<xs:annotation>
			<xs:documentation>This element defines a total price which might be the sum of prices per tariff</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Amount" type="AmountEuroCentType">
				<xs:annotation>
					<xs:documentation>amount in euro cent - element 52</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartialPrice" type="PartialPriceType" minOccurs="0" maxOccurs="3">
				<xs:annotation>
					<xs:documentation>price parts per tariff</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VAT" type="VatDetailType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="Type" type="PriceTypeType" default="0">
			<xs:annotation>
				<xs:documentation>element 67 - type of the price</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="VatDetailType">
		<xs:annotation>
			<xs:documentation>In case only a part of the VAT is provided (e.g. for the contry of sale the amount needs to be included.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Country" type="CountryCodeISO2AType"/>
			<xs:element name="Percentage" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>percentarge in units of 0.1 per cent</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amount" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>amount of the VAT in Euro-Cent</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaxId" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>TaxId of the company paying the tax</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequestorType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data describing the requestor.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Terminal" type="TerminalType"/>
		</xs:sequence>
		<xs:attribute name="RequestingSystem" type="ReservationSystemType" use="required">
			<xs:annotation>
				<xs:documentation>System that is addressed in a request: element 1 - receiving system</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SendingSystem" type="ReservationSystemType" use="required">
			<xs:annotation>
				<xs:documentation>element 2 sending system</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="RequestedTrainType">
		<xs:annotation>
			<xs:documentation xml:lang="en">All data needed to identify a train in a request.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="TrainNumberType">
				<xs:annotation>
					<xs:documentation>element 20 traiun number </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="DepartureStation" type="StationCode918Type">
				<xs:annotation>
					<xs:documentation>departure station. The code fromm context "918" (reservation station codes) has to be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArrivalStation" type="StationCode918Type"/>
		</xs:sequence>
		<xs:attribute name="AcceptDifferentTrain" type="xs:boolean" default="false">
			<xs:annotation>
				<xs:documentation>true = another train different than requested is acceptable (element 44)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SequenceId" type="SequenceIdType" use="required">
			<xs:annotation>
				<xs:documentation>element 17 serial number</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="JourneyId" type="JourneyIdentifierType" use="optional" default="0">
			<xs:annotation>
				<xs:documentation>element 32 journey number </xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="RequestedMealType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to describe a desired meal.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NumberOfMeals" type="NumberOfPassengerType"/>
			<xs:element name="TimeOfMeal" type="xs:time" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="Type" type="TypeOfMealType" use="required">
			<xs:annotation>
				<xs:documentation>type of the meal:

    B: breakfast
    L: lunch
    D: dinner

</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="ReferenceNumberType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Reference of a reservation. The reference is unique only when combined with travel date and train number.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="AllocatingSystem" type="ReservationSystemType"/>
		<xs:attribute name="LocalReference" type="LocalReferenceNumberType"/>
	</xs:complexType>
	<xs:complexType name="RefundType">
		<xs:annotation>
			<xs:documentation xml:lang="en">All data converning the refund in cancellations and partial cancellations.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="BookedOfferType">
				<xs:attribute name="PriceChanged" type="xs:boolean" use="optional" default="false">
					<xs:annotation>
						<xs:documentation>price is changed due to a cancellation fee - element 75 </xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RestaurantSeatAllocationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Allocation of seats.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocatedTrain" type="AllocatedTrainType"/>
			<xs:element name="Meals" type="BookedMealType" minOccurs="0" maxOccurs="3"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RestaurantSeatRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Data to request an allocation of a restaurant seat.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedTrain" type="RequestedTrainType"/>
			<xs:element name="Meals" type="RequestedMealType" maxOccurs="3"/>
		</xs:sequence>
		<xs:attribute name="IndividualTicketing" type="xs:boolean" default="false"/>
	</xs:complexType>
	<xs:complexType name="RollbackBookingRequestType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Request to cancell a booking caused by technical problems. Cancellations requested by a customer must not be made with this element.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="Reference" type="ReferenceNumberType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Reference of the booking, that has to be cancelled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Service" type="ServiceType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Service booked with the original booking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceBreakfast" type="ReferenceNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">Reference of an additionally booked breakfast.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceLunch" type="ReferenceNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">Reference of an additionally booked lunch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceDinner" type="ReferenceNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">Reference of an additionally booked dinner.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OriginalDialogue" type="DialogueNumberType">
				<xs:annotation>
					<xs:documentation xml:lang="en">Identification of the original dialogue. The dialogue number can be used to identify the booking only for a few minutes after the orriginal dialogue.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RollbackBookingConfirmationType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Confirmation of a erquested rollback.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Train" type="TrainNumberType"/>
			<xs:element name="DepartureDate" type="xs:date"/>
			<xs:element name="Reference" type="ReferenceNumberType"/>
			<xs:element name="OriginalDialogNumber" type="DialogueNumberType"/>
			<xs:element name="Service" type="ServiceType"/>
